/**
 * A documented function.
 *
 * @param client    The client.
 */
public void Documented(int client)  // trailing
{   // after the brace
	int a = 1;      // one
	int bb = 2;  // two

	int ccc = 3; // three
	if (client) // the condition
	{
		a = 2;
	}
	    /*
	     * Indented with spaces
	     *   and more.
	     */
	a = 3;
	/*
		int old = 1;
	*/
}
